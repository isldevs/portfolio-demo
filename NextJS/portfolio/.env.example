# Run: python scripts/init_env.py  (creates .env with random secrets)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=GENERATE_RANDOM_POSTGRES_PASSWORD
INTERNAL_API_KEY=GENERATE_RANDOM_INTERNAL_API_KEY
IP_HASH_SALT=GENERATE_RANDOM_HASH_SALT
# Local: http://localhost:3000. Production: https://your-domain.com
SITE_URL=http://localhost:3000
# Only used by compose.prod.yml; point DNS A/AAAA records to the VPS.
DOMAIN=example.com
